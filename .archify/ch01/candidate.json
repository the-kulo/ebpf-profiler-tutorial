  "cards": [
    {
      "dot": "cyan",
      "title": "编译链",
      "items": [
        "clang -emit-llvm → llvm-link → llc -march=bpf → tracer.ebpf.<arch>",
        "llvm-strip 后 print_instruction_count.sh 统计每个程序指令数",
        "所有解释器回溯器编进同一个 ELF（全家桶）"
      ]
    },
    {
      "dot": "emerald",
      "title": "挂载链",
      "items": [
        "perf.CPUClock + SetSampleFreq(20) → 每 CPU 一个 perf event",
        "perfEvent.SetBPF 把入口程序 fd 绑到事件",
        "控制器启动时 AttachTracer + EnableProfiling"
      ]
    },
    {
      "dot": "rose",
      "title": "verifier 三限制与应对",
      "items": [
        "4096 指令 → 尾调用拆程序",
        "512 字节栈 → 大对象放 per-CPU map",
        "有界循环 → NATIVE_FRAMES_PER_PROGRAM=5"
      ]
    },
    {
      "dot": "amber",
      "title": "回传链",
      "items": [
        "send_trace 只发有效载荷：offsetof(variable_data)+variable_data_end*8",
        "MIN 钳制写给 verifier 看",
        "BPF_RB_NO_WAKEUP：内核不敲门，因为收信人定时自取",
        "每 250ms ReadInto 非阻塞读空 → traceOutChan"
      ]
    }
  ]
