  "cards": [
    {
      "dot": "cyan",
      "title": "手工流水线三理由",
      "items": [
        "map 大小要加载时动态调整（ringbuf = 采样率×CPU×Trace 体积）",
        "要探测内核特性：probeNoPrealloc 用玩具程序试探",
        "同一批程序要改造成 kprobe 版本并改写 per_cpu_records 引用"
      ]
    },
    {
      "dot": "emerald",
      "title": ".rodata 配置注入",
      "items": [
        "BPF_RODATA_VAR 声明 → ELF .rodata.var 段",
        "加载前 Set 值 → 程序读到的就是新值",
        "BTF 算出 task_struct 字段偏移注入；读不到 BTF 时用临时探针退路"
      ]
    },
    {
      "dot": "rose",
      "title": "三条回传通道",
      "items": [
        "trace_events：ring buffer 轮询，高频调用栈",
        "report_events：perf event array 阻塞，低频紧急通知",
        "pid_events：哈希 map 批量读删，PID 集合"
      ]
    },
    {
      "dot": "amber",
      "title": "C/Go 契约",
      "items": [
        "cgo -godefs 从 types.h 生成 types.go，diff 守门",
        "Trace 变长区用四个 u16 游标自描述",
        "loadBpfTrace unsafe 强转前先验长度下限"
      ]
    }
  ]
