  "cards": [
    {
      "dot": "cyan",
      "title": "LPM 调度中枢",
      "items": [
        "pid_page_to_mapping_info 一次匹配回答「谁回溯 + bias 多少」",
        "bias_and_unwind_program：高 8 位程序号 + 低 56 位 bias 同字段",
        "LPM 天然适合嵌套地址区间：JIT 区用更长前缀「抢」走外围映射"
      ]
    },
    {
      "dot": "emerald",
      "title": "segmap 倒推",
      "items": [
        "segmap[i] 存「往回几段是 CodeBlob 起点」，≤12 步回退",
        "segmap 起始地址由 Agent 埋进 LPM 条目的 file_id",
        "内核态对 JVM 一无所知——用户态把坐标系全准备好了"
      ]
    },
    {
      "dot": "rose",
      "title": "CodeBlob 分派与跳帧",
      "items": [
        "类型名首 4 字节当 u32 比较：nmethod / Interpreter / vtable / Stub",
        "nmethod 用 frame_size 跳帧 + ≤6 槽返回地址启发式扫描",
        "合法性校验复用 LPM——调度器亦是地址校验器"
      ]
    },
    {
      "dot": "amber",
      "title": "刚性限制",
      "items": [
        "每次尾调用只解固定帧数（4 帧），用次数换指令预算",
        "tailCalls ≤29 强制 STOP（32 上限留余量）",
        "内核只搬指针和数字——字符串/符号化全留用户态"
      ]
    }
  ]
