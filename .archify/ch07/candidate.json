  "cards": [
    {
      "dot": "cyan",
      "title": "懒发现哲学",
      "items": [
        "不用 exec/fork tracepoint——采样失败本身是最精确的发现信号",
        "只对真正被采样的进程建档，开销与价值成正比",
        "自愈能力：未知 PC 触发重新同步，错误即触发器"
      ]
    },
    {
      "dot": "emerald",
      "title": "双通道通知",
      "items": [
        "pid_events map：事实层，天然去重，周期批量捞取兜底",
        "report_events perf event：唤醒层，inhibit_events 锁存防风暴",
        "一个通道两种语义——新进程/退出由用户态读 /proc 时消歧"
      ]
    },
    {
      "dot": "rose",
      "title": "两阶段清理",
      "items": [
        "processPIDExit 立即删 LPM 条目——防 PID 复用串味",
        "ProcessedUntil 水位等 trace 管道排空后再删 Go 侧状态",
        "CleanupPIDs 定期 kill(0) 探活——快路径 + 兜底"
      ]
    },
    {
      "dot": "amber",
      "title": "ExecInfoManager 去重",
      "items": [
        "按文件去重：100 进程同 libc.so → stack delta 只析一次",
        "12 个 loader 海选：逐个 Load → 认领或弃权",
        "Stack delta 经 map-in-map 批量下发 + 中途失败精确回滚"
      ]
    }
  ]
