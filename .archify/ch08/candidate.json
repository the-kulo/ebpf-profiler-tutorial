  "cards": [
    {
      "dot": "cyan",
      "title": "三层聚合结构",
      "items": [
        "ResourceKey：容器ID/服务名/PID——这是谁的样本",
        "TypeMetadata：on-CPU / off-CPU——哪种测量",
        "SampleKey：Hash + TID + CPU + SpanID——哪条栈"
      ]
    },
    {
      "dot": "emerald",
      "title": "聚合核心优化",
      "items": [
        "命中已有 Key 只 append Timestamps——Frames 零拷贝",
        "内存从 O(采样数×栈) 降到 O(不同栈×栈 + 采样数×16B)",
        "聚合树就是 OTLP wire format 的预排版"
      ]
    },
    {
      "dot": "rose",
      "title": "swap-clear + delta 语义",
      "items": [
        "三行代码换出整棵树：持锁微秒级，不阻塞采集路径",
        "新窗口从零累计——内存恒定一个窗口大小",
        "CollectionStartTime / DurationNano 精确标注窗口边界"
      ]
    },
    {
      "dot": "amber",
      "title": "失败即弃哲学",
      "items": [
        "Profiling 是统计性数据：丢一个窗口火焰图形状不变",
        "无重试队列/磁盘缓冲/反压——防 OOM 伤害宿主机",
        "两种形态：独立 agent gRPC push vs Collector receiver 内嵌"
      ]
    }
  ]
